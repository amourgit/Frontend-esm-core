# ============================================================
# EGEN — Fichier d'environnement exemple
# Copier ce fichier en .env et adapter les valeurs
# ============================================================

# --- SPA Shell ---
# Chemin public de la SPA
EIGEN_PUBLIC_PATH=/egen/spa

# URL de l'API backend (proxy local uniquement, ne jamais pointer vers un serveur externe)
EIGEN_API_URL=/egen

# Cible du proxy : ton backend EGEN local (FastAPI / Keycloak)
EIGEN_PROXY_TARGET=http://localhost:8081/

# Titre de la page (affiché dans l'onglet du navigateur)
EIGEN_PAGE_TITLE=EGEN — Plateforme Éducative Nationale

# Importmap inline vide → les apps locales buildées se chargent via coreImportmap
# Laisser cette variable définie pour ne faire AUCUN appel réseau externe
EIGEN_ESM_IMPORTMAP={"imports":{}}

# Registre de routes inline vide → idem
EIGEN_ROUTES={}

# Mode offline (disable = pas de service worker en dev)
EIGEN_OFFLINE=disable

# Locale par défaut
EIGEN_ESM_DEFAULT_LOCALE=fr

# --- Tests E2E ---
E2E_BASE_URL=http://localhost:8081/egen
E2E_USER_ADMIN_USERNAME=admin
E2E_USER_ADMIN_PASSWORD=Admin123
E2E_LOGIN_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1

# ============================================================
# SYSTÈME MULTI-TENANT — @egen/esm-tenant
# ============================================================
#
# Ces variables contrôlent le système de gestion des tenants.
# Toutes sont OPTIONNELLES. Par défaut le système est OFF (désactivé).
#
# PRIORITÉ DE CONFIGURATION (du plus fort au plus faible) :
#   1. Argument direct à setupTenantSystem({ ... })  dans run.ts
#   2. window.eigenXxx   (injection HTML runtime par le serveur)
#   3. VITE_TENANT_*     (ces variables, injectées au build)
#   4. Valeurs par défaut internes
#
# ─── MODE ─────────────────────────────────────────────────
#
# VITE_TENANT_MODE
#   Contrôle global du système tenant.
#   "off"    : désactivé — zéro overhead, apps fonctionnent normalement (DÉFAUT)
#   "single" : un seul tenant, identifié par VITE_TENANT_ID
#   "multi"  : plusieurs tenants, résolution dynamique au runtime
#
VITE_TENANT_MODE=off

# ─── IDENTIFICATION ────────────────────────────────────────
#
# VITE_TENANT_ID
#   Identifiant du tenant actif.
#   Obligatoire en mode "single". En mode "multi", sert de fallback
#   si aucune stratégie de résolution ne trouve de tenant.
#   Doit correspondre à un "id" dans la registry (staticTenants ou registryUrl).
#
# VITE_TENANT_ID=civitas

# ─── REGISTRY ──────────────────────────────────────────────
#
# VITE_TENANT_REGISTRY_URL
#   URL d'un fichier JSON listant tous les tenants disponibles.
#   Format attendu : TenantDefinition[]  (voir types.ts pour le schéma complet)
#   Si absent, utiliser staticTenants dans setupTenantSystem().
#
#   Exemple de contenu JSON :
#   [
#     { "id": "acme", "name": "ACME Corp", "apiBaseUrl": "https://api.acme.com" },
#     { "id": "civitas", "name": "CIVITAS", "themeUrl": "/themes/civitas.json" }
#   ]
#
# VITE_TENANT_REGISTRY_URL=/public/tenants/registry.json

# ─── RÉSOLUTION DU TENANT ACTIF ────────────────────────────
#
# VITE_TENANT_RESOLUTION_ORDER
#   Ordre des stratégies de résolution du tenant actif (CSV, sans espaces).
#   La première stratégie qui retourne un résultat valide est utilisée.
#
#   Stratégies disponibles :
#     subdomain   — lit le sous-domaine : acme.app.com → "acme"
#     path        — lit un segment URL : /t/acme/... → "acme"
#     query       — lit ?tenant=acme dans l'URL
#     jwt         — lit un claim dans le JWT de session (configurable via VITE_TENANT_JWT_CLAIM)
#     header      — lit X-Tenant-ID stocké par le backend lors du login
#     localStorage— survie au rechargement de page (clé : egen:tenant:active)
#     static      — lit VITE_TENANT_ID ou window.eigenTenantId
#     first       — prend le premier tenant disponible dans la registry (fallback ultime)
#
#   Défaut : subdomain,path,query,jwt,header,localStorage,static,first
#
# VITE_TENANT_RESOLUTION_ORDER=subdomain,path,query,jwt,header,localStorage,static,first

# ─── STRATÉGIE "path" ──────────────────────────────────────
#
# VITE_TENANT_PATH_PREFIX
#   Préfixe de chemin URL pour la stratégie de résolution "path".
#   Exemple : "/t/" → l'URL /t/acme/dashboard extrait le tenant "acme"
#   Laisser vide pour lire le premier segment du path (ex: /acme/dashboard → "acme")
#
# VITE_TENANT_PATH_PREFIX=/t/

# ─── STRATÉGIE "jwt" ───────────────────────────────────────
#
# VITE_TENANT_JWT_CLAIM
#   Nom du claim JWT portant l'identifiant du tenant.
#   Valeurs communes : "tenantId", "tid", "org", "tenant_id"
#   Défaut : "tenantId"
#
# VITE_TENANT_JWT_CLAIM=tenantId

# ─── THÈME ─────────────────────────────────────────────────
#
# VITE_TENANT_THEME_APPLY
#   Active l'application automatique du thème défini dans TenantDefinition.themeUrl
#   ou TenantDefinition.themeOverride lors de l'activation d'un tenant.
#   Nécessite que registerTenantThemeApplier() ait été appelé dans run.ts.
#   "true" | "false"   Défaut : "true"
#
# VITE_TENANT_THEME_APPLY=true

# ─── PERSISTANCE ────────────────────────────────────────────
#
# VITE_TENANT_PERSIST
#   Active la persistance du tenant actif en localStorage entre les rechargements.
#   Clé utilisée : egen:tenant:active  (configurable via storageKey dans setupTenantSystem)
#   "true" | "false"   Défaut : "true"
#   Désactiver si le tenant doit toujours être re-résolu depuis l'URL ou le JWT.
#
# VITE_TENANT_PERSIST=true
