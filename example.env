# ============================================================
# EIGEN — Fichier d'environnement exemple
# Copier ce fichier en .env et adapter les valeurs
# ============================================================

# --- SPA Shell ---
# Chemin public de la SPA
EGEN_PUBLIC_PATH=/egen/spa

# URL de l'API backend (proxy local uniquement)
EGEN_API_URL=/egen

# Cible du proxy : ton backend EIGEN local (FastAPI / Keycloak)
# NE PAS pointer vers dev3.egen.org !
EGEN_PROXY_TARGET=http://localhost:8080/egen

# Titre de la page (affiché dans l'onglet du navigateur)
EGEN_PAGE_TITLE=EIGEN — Plateforme Éducative Nationale

# Importmap inline vide → les apps locales buildées se chargent via coreImportmap
# Laisser cette variable définie pour ne faire AUCUN appel réseau externe
EGEN_ESM_IMPORTMAP={"imports":{}}

# Registre de routes inline vide → idem
EGEN_ROUTES={}

# Mode offline (disable = pas de service worker en dev)
EGEN_OFFLINE=disable

# --- Tests E2E ---
E2E_BASE_URL=http://localhost:8080/egen
E2E_USER_ADMIN_USERNAME=admin
E2E_USER_ADMIN_PASSWORD=Admin123
E2E_LOGIN_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
# The above location UUID is for the "Outpatient Clinic" location in the reference application
