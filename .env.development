# =============================================================================
#  EGEN — Variables d'environnement de DÉVELOPPEMENT / STAGING
#  Commité comme template. Copier en .env pour usage local.
# =============================================================================

# ── Bypass auth (activer pour tests sans backend) ─────────────────────────────
# Passer à "false" ou supprimer pour activer l'authentification réelle.
EGEN_DEV_NO_AUTH=true

# ── Multi-tenant ──────────────────────────────────────────────────────────────
VITE_TENANT_MODE=multi
VITE_TENANT_RESOLUTION_ORDER=subdomain,header,jwt,localStorage,query,static,first

# Domaine racine — en dev localhost est géré automatiquement (guard skippé)
VITE_ROOT_DOMAIN=egen.gabon.gov.ga

# Registry de tenants JSON
# Créer public/tenants/registry.json avec des TenantDefinition[] pour le dev
VITE_TENANT_REGISTRY_URL=/tenants/registry.json

VITE_TENANT_THEME_APPLY=true
VITE_TENANT_PERSIST=true
VITE_TENANT_JWT_CLAIM=tenantId

# ── Système IA EIGEN (Couche 1) ───────────────────────────────────────────────
# Passer à "true" pour activer la couche IA
EIGEN_AI_ENABLED=false

EIGEN_AI_PROVIDER=gemini
EIGEN_AI_MODEL=gemini-2.5-pro
EIGEN_AI_TEMPERATURE=0.7
EIGEN_AI_TOP_P=0.95
EIGEN_AI_TOP_K=40
EIGEN_AI_MAX_TOKENS=8192
EIGEN_AI_STREAM=true

# URL du backend proxy IA (civitas-core)
EIGEN_AI_BACKEND_URL=http://localhost:8081/api/ai
EIGEN_AI_CHAT_ENDPOINT=/chat
EIGEN_AI_STREAM_ENDPOINT=/chat/stream
EIGEN_AI_REQUEST_TIMEOUT=30000
EIGEN_AI_MAX_RETRIES=3
EIGEN_AI_RETRY_DELAY=1000

# Contexte
EIGEN_AI_CONTEXT_MAX_SIZE=100000
EIGEN_AI_CONTEXT_EXTENSIONS=true
EIGEN_AI_CONTEXT_NAVIGATION=true
EIGEN_AI_CONTEXT_FLAGS=true
EIGEN_AI_CONTEXT_DEPTH=4

# Mémoire
EIGEN_AI_MEMORY_ENABLED=true
EIGEN_AI_MEMORY_MAX_MESSAGES=50
EIGEN_AI_MEMORY_PERSIST=false

# Sécurité
EIGEN_AI_VALIDATE_TOOLS=true
EIGEN_AI_TOOL_TIMEOUT=30000
EIGEN_AI_AUDIT_LOG=false

# Observabilité
EIGEN_AI_DEBUG=false
EIGEN_AI_EVENTS_ENABLED=true
EIGEN_AI_LOG_LEVEL=warn
