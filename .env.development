# =============================================================================
#  EIGEN — Variables d'environnement de DÉVELOPPEMENT / STAGING
#  Ce fichier est chargé automatiquement par dotenv dans rspack.config.js.
#  NE PAS committer de secrets ici. Pour la prod, utiliser les variables
#  d'environnement du serveur/CI directement (pas de fichier .env.production).
# =============================================================================

# ── Bypass authentification ────────────────────────────────────────────────────
# Positionner à "true" pour désactiver la redirection vers /login et injecter
# une session admin fictive. Permet de tester toutes les apps sans backend.
# OBLIGATOIREMENT "false" ou absent en production réelle.
EIGEN_DEV_NO_AUTH=true

# ── URLs de base (à adapter selon l'environnement) ────────────────────────────
# EGEN_API_URL=/eigen
# EGEN_PUBLIC_PATH=/eigen/spa
# EGEN_PROXY_TARGET=http://localhost:8081/

# ── Titre de la page ──────────────────────────────────────────────────────────
# EIGEN_PAGE_TITLE=EIGEN — Dev
