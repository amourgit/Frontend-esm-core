# =============================================================================
#  EGEN — Variables d'environnement de DÉVELOPPEMENT / STAGING
#  Commité comme template. Copier en .env pour usage local.
# =============================================================================

# ── Bypass auth (activer pour tests sans backend) ─────────────────────────────
# Passer à "false" ou supprimer pour activer l'authentification réelle.
EGEN_DEV_NO_AUTH=true

# ── Multi-tenant (voir @egen/esm-tenant) ──────────────────────────────────────
# Ces variables sont lues côté build (Node) par esm-app-shell/rspack.config.js
# et injectées dans index.html sous forme de window.egenTenant* — c'est
# l'unique canal de configuration fonctionnel dans ce projet (rspack, pas
# Vite : un éventuel VITE_* ne serait jamais lu par le bundle produit).
#
# Refonte du 8 août 2026 : plus de registry de tenants (EGEN_TENANT_REGISTRY_URL
# supprimée) — le frontend capture le tenant depuis l'URL (sous-domaine) sans
# aucune vérification, et le rend disponible via le store global + header
# X-Tenant-ID. Toute validation (existence, statut) est une responsabilité
# backend. Plus de thème piloté par tenant côté frontend non plus
# (EGEN_TENANT_THEME_APPLY supprimée) — voir docs/analyse-esm-tenant.md.
EGEN_TENANT_MODE=multi
EGEN_TENANT_RESOLUTION_ORDER=subdomain,path,query,jwt,header,localStorage,static

# Domaine racine — en dev localhost est géré automatiquement (guard skippé).
# Source unique de vérité pour toute dérivation hostname ↔ tenant, partagée
# par esm-tenant-routing-app (garde de routage) ET esm-primary-navigation-app
# (sélecteur de tenant) — voir @egen/esm-tenant utils/domain-utils.ts.
#
# VOLONTAIREMENT NON DÉFINIE ICI : le test en local se fait via des URLs
# type "http://<tenant>.localhost:<port>/..." (ex: civitas.localhost) — les
# navigateurs résolvent automatiquement tout *.localhost vers 127.0.0.1,
# sans configuration DNS ni /etc/hosts. inferRootDomain() reconnaît ce cas
# et déduit "localhost" comme racine automatiquement (voir domain-utils.ts).
#
# ⚠️ Si cette variable est définie ici avec une valeur de production
# (ex: "egen.gabon.gov.ga") alors que le hostname réel est "*.localhost",
# la stratégie "subdomain" ne capturera JAMAIS rien — un warning explicite
# s'affiche dans la console dans ce cas précis pour éviter un diagnostic
# à l'aveugle (voir resolveBySubdomain() dans context/resolver.ts).
#
# À définir en staging/production avec la vraie valeur, ex :
# EGEN_TENANT_ROOT_DOMAIN=egen.gabon.gov.ga

EGEN_TENANT_PERSIST=true
EGEN_TENANT_JWT_CLAIM=tenantId

# ── Système IA EGEN (Couche 1 + Couche 2 — voir esm-ai-assistant-app) ────────
# Passer à "false" pour désactiver entièrement le widget assistant.
EGEN_AI_ENABLED=true

EGEN_AI_PROVIDER=gemini
# gemini-3.1-flash-lite : modèle gratuit de la génération ACTUELLE (tier
# gratuit de Google AI Studio, ~15 req/min). Toute la génération 2.x
# (gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-*) est désormais
# fermée aux nouveaux comptes/clés — confirmé par deux tests directs contre
# l'API le 13/07/2026 ("no longer available to new users" sur les deux).
# Ne PAS utiliser un alias comme "gemini-flash-latest" : ces alias sont
# hot-swapés par Google sans changement de version d'API, ce qui produit le
# même 404 dès que le modèle qu'ils pointent est à son tour retiré (constaté
# publiquement sur plusieurs projets tiers). Préférer un identifiant de
# modèle explicite et le mettre à jour manuellement quand nécessaire — voir
# https://ai.google.dev/gemini-api/docs/models pour la liste à jour.
EGEN_AI_MODEL=gemini-3.1-flash-lite
EGEN_AI_TEMPERATURE=0.7
EGEN_AI_TOP_P=0.95
EGEN_AI_TOP_K=40
EGEN_AI_MAX_TOKENS=8192
EGEN_AI_STREAM=true

# ── Démarrage rapide sans backend (prototypage / développement local) ───────
# Colle UNIQUEMENT ta clé API Gemini ci-dessous (créée gratuitement sur
# https://aistudio.google.com/apikey) et EGEN_AI_DIRECT_MODE fait le reste :
# le frontend appelle Gemini directement, sans avoir besoin d'un backend
# proxy fonctionnel. Voir packages/apps/esm-ai-assistant-app/README.md pour
# l'avertissement de sécurité (clé visible côté navigateur — dev/démo
# uniquement, jamais en production réelle).
#
# ⚠️ NE JAMAIS coller une vraie clé ICI : ce fichier est suivi par git et
# poussé sur le dépôt distant. Colle ta clé dans .env.development.local
# (non suivi, voir .gitignore) — les valeurs y sont automatiquement
# prioritaires sur celles de ce fichier (voir @egen/rspack-config).
EGEN_AI_DIRECT_MODE=true
EGEN_AI_API_KEY=

# URL du backend proxy IA (civitas-core). C'EST ce backend qui détient la clé
# API Gemini (ex. GOOGLE_API_KEY dans l'environnement de civitas-core) et
# l'appelle avec function-calling — jamais le frontend, qui ne parle qu'à ce
# backend. Voir packages/apps/esm-ai-assistant-app/README.md.
EGEN_AI_BACKEND_URL=http://localhost:8081/api/ai
EGEN_AI_CHAT_ENDPOINT=/chat
EGEN_AI_STREAM_ENDPOINT=/chat/stream
EGEN_AI_REQUEST_TIMEOUT=30000
EGEN_AI_MAX_RETRIES=3
EGEN_AI_RETRY_DELAY=1000

# Contexte
EGEN_AI_CONTEXT_MAX_SIZE=100000
EGEN_AI_CONTEXT_EXTENSIONS=true
EGEN_AI_CONTEXT_NAVIGATION=true
EGEN_AI_CONTEXT_FLAGS=true
EGEN_AI_CONTEXT_DEPTH=4

# Mémoire
EGEN_AI_MEMORY_ENABLED=true
EGEN_AI_MEMORY_MAX_MESSAGES=50
EGEN_AI_MEMORY_PERSIST=false

# Sécurité
EGEN_AI_VALIDATE_TOOLS=true
EGEN_AI_TOOL_TIMEOUT=30000
EGEN_AI_AUDIT_LOG=false

# Observabilité
EGEN_AI_DEBUG=false
EGEN_AI_EVENTS_ENABLED=true
EGEN_AI_LOG_LEVEL=warn
