{
  "name": "@eigen/esm-ai-events",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Système d'événements IA EIGEN — bus d'événements typé, observable et extensible.",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "keywords": ["eigen", "microfrontends", "ai", "events"],
  "browserslist": ["extends browserslist-config-eigen"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-core.git"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@eigen/esm-ai-config": "workspace:*",
    "rxjs": "^6.5.3"
  },
  "peerDependencies": {
    "@eigen/esm-ai-config": "workspace:*",
    "rxjs": "^6.5.3"
  },
  "devDependencies": {
    "@eigen/esm-ai-config": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "rxjs": "^6.5.3",
    "vitest": "^4.1.2"
  }
}
