{
  "$schema": "https://egen.alpha.vercel.com/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.2.0"
  },
  "pages": [
    {
      "component": "root",
      "routeRegex": "^(?!(?:login|logout|change-password)/?)",
      "online": true,
      "offline": true,
      "containerDomId": "egen-top-nav-app-container"
    }
  ],
  "extensions": [
    {
      "name": "change-language",
      "slot": "user-panel-slot",
      "component": "changeLanguageLink",
      "online": true,
      "offline": true,
      "order": 1
    },
    {
      "name": "link",
      "component": "linkComponent",
      "online": true,
      "offline": true
    },
    {
      "name": "breadcrumb-item",
      "component": "breadcrumbItem",
      "online": true,
      "offline": true
    }
  ],
  "modals": [
    {
      "name": "change-language-modal",
      "component": "changeLanguageModal"
    }
  ]
}
