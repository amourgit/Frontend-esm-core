{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2015",
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": [
      "dom",
      "es2020",
      "es2022"
    ],
    "noEmit": true
  },
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/declarations.d.ts",
    "src/domain/**/*.ts",
    "src/ports/**/*.ts",
    "src/services/**/*.ts",
    "src/adapters/**/*.ts",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/runtime/**/*.ts"
  ]
}
