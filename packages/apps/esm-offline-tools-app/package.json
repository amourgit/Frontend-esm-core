{
  "name": "@egen/esm-offline-tools-app",
  "version": "9.0.2",
  "license": "MPL-2.0",
  "description": "The offline tools microfrontend for the Egen SPA",
  "browser": "dist/egen-esm-offline-tools-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "egen develop",
    "serve": "rspack serve --mode=development",
    "debug": "npm run serve",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "build": "rspack --mode=production",
    "build:development": "rspack --mode=development",
    "analyze": "rspack --mode=production --env analyze=true",
    "typescript": "tsc",
    "lint": "eslint src --ext ts,tsx",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.extension.tsx' 'src/**/*.modal.tsx' --config='../../../tools/i18next-parser.config.js'",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "egen",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egen/egen-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/egen/egen-esm-core/issues"
  },
  "homepage": "https://github.com/egen/egen-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.58.0",
    "@egen/esm-api": "workspace:*",
    "@egen/esm-config": "workspace:*",
    "@egen/esm-react-utils": "workspace:*",
    "@egen/esm-state": "workspace:*",
    "lodash-es": "^4.17.21",
    "swr": "2.2.5"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@egen/esm-api": "9.x",
    "@egen/esm-config": "9.x",
    "@egen/esm-framework": "9.x",
    "@egen/esm-react-utils": "9.x",
    "@egen/esm-state": "9.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@carbon/react": "^1.92.1",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "egen": "workspace:*",
    "happy-dom": "^20.11.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-is": "^17.0.2",
    "react-router-dom": "^6.3.0",
    "rxjs": "^6.5.3",
    "sass": "^1.98.0",
    "vitest": "^4.1.10"
  }
}
