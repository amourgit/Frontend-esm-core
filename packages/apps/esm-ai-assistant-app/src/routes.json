{
  "$schema": "https://egen.alpha.vercel.com/routes.schema.json",
  "pages": [
    {
      "component": "root",
      "routeRegex": "^(?!(?:login|logout|change-password)/?)",
      "online": true,
      "offline": false,
      "containerDomId": "egen-ai-assistant-app-container"
    }
  ],
  "extensions": [
    {
      "name": "assistant-robot-button",
      "slot": "topbar-slot",
      "component": "assistantRobotButton",
      "online": true,
      "offline": false,
      "order": 0,
      "meta": {
        "topbar": {
          "level": "navigation",
          "rank": 20,
          "region": "right",
          "order": 0
        }
      }
    },
    {
      "name": "assistant",
      "slot": "shell-rail-bottom-slot",
      "component": "assistantRailPanel",
      "online": true,
      "offline": false,
      "order": 10,
      "meta": {
        "title": "Assistant IA",
        "titleKey": "assistant",
        "icon": "Bot",
        "order": 10,
        "global": true,
        "rail": "right"
      }
    }
  ]
}
