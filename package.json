{
  "name": "@egen/esm-core",
  "version": "9.0.2",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "packages/apps/*"
  ],
  "resolutions": {
    "@types/react": "18.3.25",
    "csstype": "3.2.3",
    "@egen-civitas/egen": "portal:../Frontend-esm-framework/packages/tooling/egen",
    "@egen-civitas/esm-ai-config": "portal:../Frontend-esm-framework/packages/framework/esm-ai-config",
    "@egen-civitas/esm-ai-context": "portal:../Frontend-esm-framework/packages/framework/esm-ai-context",
    "@egen-civitas/esm-ai-events": "portal:../Frontend-esm-framework/packages/framework/esm-ai-events",
    "@egen-civitas/esm-ai-extensions": "portal:../Frontend-esm-framework/packages/framework/esm-ai-extensions",
    "@egen-civitas/esm-ai-framework": "portal:../Frontend-esm-framework/packages/framework/esm-ai-framework",
    "@egen-civitas/esm-ai-memory": "portal:../Frontend-esm-framework/packages/framework/esm-ai-memory",
    "@egen-civitas/esm-ai-tools": "portal:../Frontend-esm-framework/packages/framework/esm-ai-tools",
    "@egen-civitas/esm-api": "portal:../Frontend-esm-framework/packages/framework/esm-api",
    "@egen-civitas/esm-app-shell": "portal:../Frontend-esm-framework/packages/shell/esm-app-shell",
    "@egen-civitas/esm-config": "portal:../Frontend-esm-framework/packages/framework/esm-config",
    "@egen-civitas/esm-context": "portal:../Frontend-esm-framework/packages/framework/esm-context",
    "@egen-civitas/esm-data-api": "portal:../Frontend-esm-framework/packages/framework/esm-data-api",
    "@egen-civitas/esm-dynamic-loading": "portal:../Frontend-esm-framework/packages/framework/esm-dynamic-loading",
    "@egen-civitas/esm-error-handling": "portal:../Frontend-esm-framework/packages/framework/esm-error-handling",
    "@egen-civitas/esm-expression-evaluator": "portal:../Frontend-esm-framework/packages/framework/esm-expression-evaluator",
    "@egen-civitas/esm-extensions": "portal:../Frontend-esm-framework/packages/framework/esm-extensions",
    "@egen-civitas/esm-feature-flags": "portal:../Frontend-esm-framework/packages/framework/esm-feature-flags",
    "@egen-civitas/esm-framework": "portal:../Frontend-esm-framework/packages/framework/esm-framework",
    "@egen-civitas/esm-globals": "portal:../Frontend-esm-framework/packages/framework/esm-globals",
    "@egen-civitas/esm-navigation": "portal:../Frontend-esm-framework/packages/framework/esm-navigation",
    "@egen-civitas/esm-offline": "portal:../Frontend-esm-framework/packages/framework/esm-offline",
    "@egen-civitas/esm-react-utils": "portal:../Frontend-esm-framework/packages/framework/esm-react-utils",
    "@egen-civitas/esm-routes": "portal:../Frontend-esm-framework/packages/framework/esm-routes",
    "@egen-civitas/esm-state": "portal:../Frontend-esm-framework/packages/framework/esm-state",
    "@egen-civitas/esm-styleguide": "portal:../Frontend-esm-framework/packages/framework/esm-styleguide",
    "@egen-civitas/esm-tenant": "portal:../Frontend-esm-framework/packages/framework/esm-tenant",
    "@egen-civitas/esm-theme": "portal:../Frontend-esm-framework/packages/framework/esm-theme",
    "@egen-civitas/esm-translations": "portal:../Frontend-esm-framework/packages/framework/esm-translations",
    "@egen-civitas/esm-utils": "portal:../Frontend-esm-framework/packages/framework/esm-utils",
    "@egen-civitas/rspack-config": "portal:../Frontend-esm-framework/packages/tooling/rspack-config",
    "@egen-civitas/storybook": "portal:../Frontend-esm-framework/packages/tooling/storybook",
    "@egen-civitas/typedoc-plugin-file-categories": "portal:../Frontend-esm-framework/packages/tooling/typedoc-plugin-file-categories",
    "@egen-civitas/webpack-config": "portal:../Frontend-esm-framework/packages/tooling/webpack-config",
    "browserslist-config-egen": "portal:../Frontend-esm-framework/packages/tooling/browserslist-config-egen"
  },
  "scripts": {
    "run:egen": "egen",
    "ci:publish-next": "yarn workspaces foreach --all --topological --exclude @egen/esm-core --exclude @egen/storybook npm publish --tolerate-republish --access public --tag next",
    "ci:publish": "yarn workspaces foreach --all --topological --exclude @egen/esm-core --exclude @egen/storybook npm publish --tolerate-republish --access public --tag latest",
    "release": "yarn workspaces foreach --all --topological version",
    "build": "turbo run build",
    "build:apps": "turbo run build --filter='@egen/*-app'",
    "document": "turbo run document",
    "setup": "yarn install && turbo run build",
    "start": "egen develop --sources \"packages/apps/*\"",
    "verify": "turbo run lint test typescript",
    "postinstall": "husky install",
    "test": "turbo run test",
    "test-e2e": "./e2e/support/github/run-e2e-docker-env.sh",
    "coverage": "turbo run test --coverage",
    "storybook": "yarn workspace @egen/storybook storybook"
  },
  "devDependencies": {
    "@egen-civitas/egen": "^1.0.0",
    "@egen-civitas/esm-app-shell": "^1.0.2",
    "@playwright/test": "^1.55.1",
    "@rspack/cli": "1.7.9",
    "@rspack/core": "1.7.9",
    "@swc/core": "1.15.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.16.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "browserslist-config-egen": "^1.0.0",
    "classnames": "^2.3.2",
    "cross-env": "^10.1.0",
    "dotenv": "^16.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-playwright": "^2.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^7.1.1",
    "fake-indexeddb": "^4.0.2",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "husky": "^8.0.3",
    "i18next-parser": "^9.3.0",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swc-loader": "0.2.7",
    "timezone-mock": "^1.2.2",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.105.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --write --list-different"
  }
}
